# Biến môi trường CheckCTS web. Sao chép thành .env hoặc đặt trong PM2/aaPanel.
# (server.js đọc trực tiếp process.env; nếu dùng file .env hãy nạp qua công cụ của bạn.)

# Cổng web nội bộ (Nginx reverse proxy trỏ tới cổng này)
PORT=3900

# Khóa truy cập phần lịch sử /api/history (KHÔNG công khai). BẮT BUỘC đổi.
CHECKCTS_ADMIN_KEY=DOI_KHOA_NAY

# (Tùy chọn) Font tiếng Việt cho báo cáo PDF nếu hệ thống thiếu font:
# CHECKCTS_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# CHECKCTS_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
